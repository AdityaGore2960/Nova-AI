# =============================================================================
# Nova-AI — Root .gitignore
# Covers: Python/FastAPI (ai/), Node.js (backend/), Next.js (frontend/)
# =============================================================================

# ─── OS & Editor ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# JetBrains IDEs (PyCharm, WebStorm, etc.)
.idea/
*.iml

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# Vim / Emacs swap files
*.swp
*.swo
*~

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
secrets/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt
pip-delete-this-directory.txt

# ─── Python (ai/) ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST
*.whl

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
*.coveragerc
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ─── Node.js (backend/ & frontend/) ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity

# Package manager lock files (keep one; ignore others)
# Uncomment whichever you do NOT use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ─── Next.js (frontend/) ─────────────────────────────────────────────────────
.next/
out/
.vercel
next-env.d.ts

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
dist/
build/

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/

# ─── Docker ──────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ─── Misc ────────────────────────────────────────────────────────────────────
*.pem
.cache/
tmp/
temp/
