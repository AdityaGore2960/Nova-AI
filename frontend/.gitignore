# =============================================================================
# Nova-AI — frontend/ service .gitignore  (Next.js / TypeScript)
# =============================================================================

# Environment & secrets
.env
.env.*
!.env.example
!.env.local.example
*.pem

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm
.yarn-integrity

# Next.js
/.next/
/out/

# Build output
/build
/dist

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing & coverage
/coverage
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# Storybook
storybook-static/

# OS
.DS_Store
Thumbs.db

# Misc
.cache/
tmp/
temp/
